# Full Moon TV environment variables

# Venice API key (required for video generation; without it, dev mode mocks generation)
VENICE_API_KEY=

# LLM API key for prompt-chaining (OpenRouter or Anthropic — pick one)
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# Price per prompt in USDC (default: 1.0)
PRICE_PER_PROMPT_USDC=1.0

# Server port (default: 3000)
PORT=3000
